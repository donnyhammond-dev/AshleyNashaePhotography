@model FAQ

<div class="booking-container">
	<section class="booking-content">

		<h1 class="print-header">ADD FAQ</h1>

		<form asp-action="AddFAQ"
			  method="post"
			  class="submit-spinner d-flex flex-column align-items-center gap-4">

			<div asp-validation-summary="All" class="text-danger"></div>

			<div class="d-flex flex-row gap-2 w-100">
				<label asp-for="Question" class="form-label text-nowrap">Q - </label>
				<textarea asp-for="Question" class="form-control" rows="2"></textarea>
			</div>

			<div class="d-flex flex-row gap-2 w-100">
				<label asp-for="Answer" class="form-label text-nowrap">A - </label>
				<textarea asp-for="Answer" class="form-control" rows="2"></textarea>
			</div>

			<button type="submit" class="site-button" title="Add FAQ">ADD FAQ</button>

		</form>


	</section>

</div>