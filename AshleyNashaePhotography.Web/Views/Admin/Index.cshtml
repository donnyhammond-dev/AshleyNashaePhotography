@using AshleyNashaePhotography.Web.Enums;
@using AshleyNashaePhotography.Web.ViewModels;

@model AdminViewModel

<!--Calendar Json Data-->
@{
    var bookedDatesJson =
        System.Text.Json.JsonSerializer.Serialize(Model.BookedDates);

    var blockedDatesJson =
        System.Text.Json.JsonSerializer.Serialize(Model.BlockedDates);
}

<!-- Flatpickr CSS -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

<!--Container-->
<section class="basic-container">
    <div class="admin-content">

        <h1 class="print-header">BOOKINGS</h1>

        <!--Bookings Table -->
        <div class="table-responsive mb-5">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>DATE</th>
                        <th>CLIENT</th>
                        <th>SESSION TYPE</th>
                        <th>EMAIL</th>
                        <th>PHONE</th>
                        <th>NOTES</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var session in Model.Sessions)
                    {
                        <tr>
                            <td>@session.Date</td>
                            <td>@(session.LastName + ", " + session.FirstName)</td>
                            <td>@session.SessionType!.Name</td>
                            <td>@session.Email</td>
                            <td>@session.PhoneNumber</td>
                            <td>@session.ClientNotes</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <hr class="my-5" />  <!--Line Seperation-->

        <!--Availability/Calendar-->
        <h1 class="print-header">AVAILABILITY</h1>

        <div class="d-flex flex-column align-items-center gap-4">
            <div class="admin-calendar">
                <input id="availability-calendar" class="d-none" />
            </div>

            <a asp-controller="Admin"
               asp-action="EditAvailability"
               class="site-button">
                Edit Availability
                <i class="bi bi-pencil fs-6 ms-2"></i>
            </a>
        </div>

        <hr class="my-5" />  <!--Line Seperation-->

        <!--Session Type Details-->
        <h1 class="print-header">SESSION TYPES</h1>

        <div class="d-flex flex-column align-items-center gap-4">

            <!--Table-->
            <div class="table-responsive w-100 ">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>SESSION</th>
                            <th>DURATION</th>
                            <th>DESCRIPTION</th>
                            <th>PRICE</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var sessionType in Model.SessionTypes)
                        {
                            <tr>
                                <td>@sessionType.Name</td>
                                <td>@(sessionType.DurationMinutes + " Minutes")</td>
                                <td>@sessionType.Description</td>
                                <td>@sessionType.Price</td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!--Button-->
            <a asp-controller="Admin"
               asp-action="EditSessionTypes"
               class="site-button">
                Edit Details
                <i class="bi bi-pencil fs-6 ms-2"></i>
            </a>

        </div>


        <hr class="my-5" />  <!--Line Seperation-->

        <!--Edit Portfolios-->
        <h1 class="print-header">PORTFOLIOS</h1>

        <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-4">
            @foreach (var portfolio in Model.Portfolios)
            {
                <div class="basic-card portfolio-card"
                     style="background-image:
                                linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)),
                                url('@portfolio.HeroImage?.ImagePath')">
                    <div class="d-flex flex-column align-items-center gap-2">
                        <h1 class="text-white">@portfolio.Title</h1>
                        <p class="text-white">@(portfolio.Photos.Count + " Photos")</p>
                        <a asp-controller="Admin"
                           asp-action="EditPortfolio"
                           asp-route-id="@portfolio.Id"
                           class="site-button site-button-sm text-white border-white">
                            Edit<i class="bi bi-pencil fs-6 ms-2"></i>
                        </a>
                    </div>

                </div>
            }
        </div>

        <hr class="my-5" />  <!--Line Seperation-->

        <!--Edit Home Page-->
        <h1 class="print-header">HOME PAGE</h1>

        <div class="basic-card portfolio-card mx-auto"
             style="background-image:
                                linear-gradient(rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.35)),
                                url('@Model.HomePage.AboutMePhoto!.ImagePath')">
            <div class="d-flex flex-column align-items-center gap-2">
                <h1 class="text-white brand-logo">Ashley Nashae Photography</h1>
                <a asp-controller="Admin"
                   asp-action="EditHomePage"
                   class="site-button site-button-sm text-white border-white">
                    Edit<i class="bi bi-pencil fs-6 ms-2"></i>
                </a>
            </div>

        </div>

        <hr class="my-5" />  <!--Line Seperation-->

        <!--FAQ Management-->
        <h1 class="print-header">FAQ</h1>

        <div class="d-flex flex-column gap-5" id="faqs">

            @foreach (var faq in Model.FAQs)
            {
                <div>
                    <p>Q - @faq.Question</p>

                    <p>A - @faq.Answer</p>

                    <div class="d-flex flex-row gap-1">
                        <a asp-action="EditFAQ" asp-route-id="@faq.Id" class="site-button site-button-sm">
                            <i class="bi bi-pencil fs-6"></i>
                        </a>

                        <form asp-action="DeleteFAQ"
                              asp-route-id="@faq.Id"
                              method="post">

                            <button type="submit"
                                    class="site-button site-button-sm">
                                <i class="bi bi-x-lg fs-6"></i>
                            </button>

                        </form>
                    </div>
                </div>
            }

            <a asp-action="AddFAQ" class="site-button align-self-center" style="max-width: 200px">
                Add FAQ
                <i class="bi bi-plus-lg fs-6 ms-2"></i>
            </a>
        </div>

    </div>


</section>


<!--JS for Calendar-->
@section Scripts {
    <script>
        const bookedDates = @Html.Raw(bookedDatesJson);
        const blockedDates = @Html.Raw(blockedDatesJson);
    </script>

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/admin-calendar.js"></script>
}