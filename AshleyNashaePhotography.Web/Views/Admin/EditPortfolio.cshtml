@using AshleyNashaePhotography.Web.Enums

@model Portfolio

<div class="basic-container text-center">

    <section class="basic-content">

        <h1 class="print-header mb-4">EDIT PORTFOLIO</h1>

        <!--Portfolio Details Form-->
        <form asp-controller="Admin"
              asp-action="EditPortfolio"
              class="d-flex flex-column align-items-center gap-4"
              method="post">

            <!-- Portfolio Id -->
            <input asp-for="Id" type="hidden" />

            <!-- Title -->
            <div class="w-100" style="max-width: 450px;">
                <label asp-for="Title"
                       class="form-label h4 print-header"></label>

                <input asp-for="Title"
                       class="form-control" />

                <span asp-validation-for="Title" class="text-danger"></span>

               
            </div>

            <!-- Quote -->
            <div class="w-100" style="max-width: 700px;">
                <label asp-for="Quote"
                       class="form-label h4 print-header"></label>

                <textarea asp-for="Quote"
                          class="form-control"
                          rows="4"></textarea>

                <span asp-validation-for="Quote" class="text-danger"></span>

            </div>

            <div>
                <label asp-for="QuoteTextColor" class="form-label">Quote Text Color</label>
                <select asp-for="QuoteTextColor" asp-items="Html.GetEnumSelectList<FontColor>()" class="form-select"></select>
            </div>

            <!-- Submit -->
            <button type="submit" class="site-button">
                Save Changes
            </button>

        </form>

        <hr class="my-5" /> <!--Line Seperation-->

        <!--Change Hero Form-->
        <form asp-controller="Admin" asp-action="ChangeHero"
              class="d-flex flex-column align-items-center gap-4"
              method="post"
              enctype="multipart/form-data">

              <input asp-for="Id" type="hidden" />

            <!-- Current Hero -->
            <div>
                <h2 class="print-header">FEATURED PHOTO</h2>

                @if (Model.HeroImage != null)
                {
                    <img src="@Model.HeroImage.ImagePath"
                         alt="@Model.Title hero image"
                         class="admin-hero-preview" />
                }
            </div>

            <!--New Hero-->
            <div>
                <label for="heroFile" class="form-label h4 print-header">
                    Select New Featured Photo
                </label>

                <input type="file"
                       id="heroFile"
                       name="heroFile"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" />

                @Html.ValidationMessage("heroFile", null, new { @class = "text-danger" })

            </div>

            <button type="submit" class="site-button">
                Save Changes
            </button>
        </form>

        <hr class="my-5" /> <!--Line Seperation-->

        <!--Photos-->
        <div class="d-flex flex-column align-items-center gap-4">

            <h2 id="photos" class="print-header">PHOTOS</h2>

          <!--Current Photos-->
            <div id="sortable-photos"
                 class="d-flex flex-wrap justify-content-center gap-3">

                @foreach (var photo in Model.Photos)
                {
                    <div class="admin-photo-wrapper" data-id="@photo.Id">
                        <img src="@photo.ImagePath"
                             alt="@Model.Title portfolio photo"
                             class="admin-photo-thumbnail" />

                        <form asp-controller="Admin"
                              asp-action="RemovePhoto"
                              method="post">

                            <input type="hidden"
                                   name="photoId"
                                   value="@photo.Id" />

                            <input type="hidden"
                                   name="portfolioId"
                                   value="@Model.Id" />

                            <!--Remove Photo-->
                            <button type="submit"
                                    title="Delete Photo"
                                    class="photo-delete">
                                <i class="bi bi-x-lg"></i>
                            </button>

                        </form>
                    </div>
                }

            </div>

            <!--Add New Photo-->
            <form asp-controller="Admin" asp-action="AddPhoto"
                  method="post"
                  enctype="multipart/form-data"
                  class="d-flex flex-column align-items-center gap-4">

                <input asp-for="Id" type="hidden" />

                <div>
                    <label for="photoFile" class="form-label h4 print-header">
                        Add New Photo
                    </label>

                    <input type="file"
                           id="photoFile"
                           name="photoFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    @Html.ValidationMessage("photoFile", null, new { @class = "text-danger" })

                </div>

                <button type="submit" class="site-button">
                    Add Photo
                </button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const photoContainer = document.getElementById("sortable-photos");

        new Sortable(photoContainer, {
            animation: 150,

            onEnd: async function () {

                const photoIds = Array.from(photoContainer.children)
                    .map(photo => Number(photo.dataset.id));

                const response = await fetch('@Url.Action("ReorderPhotos", "Admin")', {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(photoIds)
                });

                if (!response.ok) {
                    alert("Could not save photo order.");
                }
            }
        });
    </script>
}

<!--Add photo fail anchor-->
@if (ViewData.ModelState.ContainsKey("photoFile") &&
     ViewData.ModelState["photoFile"]!.Errors.Count > 0)
{
    <script>
        document.getElementById("photos")?.scrollIntoView();
    </script>
}