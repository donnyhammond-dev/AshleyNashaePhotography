@using AshleyNashaePhotography.Web.ViewModels

@model HomePageViewModel

<!--Hero/Portfolio Navigation-->
<div class="basic-container">
	<section class="hero-section d-flex flex-column"
			 id="hero"
			 data-image="@Model.Portfolio3.HomePageHeroImage?.ImagePath"
			 style="background-image: url('@Model.Portfolio3.HomePageHeroImage?.ImagePath')">

		<nav class="hero-navigation d-flex w-100 justify-content-around mt-6">
			<a asp-controller="Portfolio"
			   asp-action="Portfolio1"
			   data-image="@Model.Portfolio1.HomePageHeroImage?.ImagePath"
			   title="View Portfolio">
			   @Model.Portfolio1.Title
		   </a>

			<a asp-controller="Portfolio"
			   asp-action="Portfolio2"
			   data-image="@Model.Portfolio2.HomePageHeroImage?.ImagePath"
			   title="View Portfolio">
				@Model.Portfolio2.Title
			</a>

			<a asp-controller="Portfolio"
			   asp-action="Portfolio3"
			   data-image="@Model.Portfolio3.HomePageHeroImage?.ImagePath"
			   title="View Portfolio">
				@Model.Portfolio3.Title
		   </a>

		</nav>

		<div class="hero-quote mt-auto text-center">
			<p>@Model.HomePage.HeroQuote</p>
		</div>

	</section>
</div>

<!--About Me Section-->
<div class="about-container">

	<div class="about-content">
		<p>@Model.HomePage.AboutMeDescription</p>
	</div>

	<img class="about-photo mb-5"
		 src="@Model.HomePage.AboutMePhoto?.ImagePath"
		 alt="Ashley" />
</div>

<!--Reviews-->
<div class="about-container">
	<div class="about-content">

		<div class="d-flex flex-column align-items-center gap-4">
			
			@foreach (var review in Model.Reviews)
			{
				<div>
					<p class="font-cursive">@review.ReviewText</p>
					<p class="font-cursive">@(review.FirstName + " " + review.LastInitial)</p>
				</div>
			}
		</div>

	</div>
</div>




@section Scripts {
	<script src="~/js/hero.js"></script>
}