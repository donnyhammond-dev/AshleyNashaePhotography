@using AshleyNashaePhotography.Web.Models

@model HomePage

<div class="hero-container">
	<section class="hero-section d-flex flex-column"
			 id="hero"
			 style="background-image: url('@Model.HeroWild?.ImagePath')">

		<nav class="hero-navigation d-flex w-100 justify-content-around mt-6">
			<a asp-controller="Portfolio"
			   asp-action="Love"
			   data-image="@Model.HeroLove?.ImagePath"
			   title="View Love Portfolio">Love
		   </a>

			<a asp-controller="Portfolio"
			   asp-action="Celebrate"
			   data-image="@Model.HeroCelebration?.ImagePath"
			   title="View Celebrate Portfolio">Celebrate
		   </a>

			<a asp-controller="Portfolio"
			   asp-action="Wild"
			   data-image="@Model.HeroWild?.ImagePath"
			   title="View Wild Portfolio">Wild
		   </a>
		</nav>

		<div class="hero-quote mt-auto text-center">
			<p>@Model.HeroQuote</p>
		</div>


	</section>

</div>

@section Scripts {

	<script src="~/js/hero.js"></script>

}