@using AshleyNashaePhotography.Web.Models
@using AshleyNashaePhotography.Web.Enums

@model Portfolio

<!--Hero-->
<div class="hero-container">
	<section class="portfolio-section d-flex justify-content-center align-items-center"
			 style="background-image: url('@Model.HeroImage?.ImagePath');">

			 <!--Quote Font Colors-->
		@{
			string textColor = Model.QuoteTextColor switch
			{
				FontColor.White => "text-white",
				FontColor.Black => "text-black",
				FontColor.Cream => "text-cream",
				_ => "text-white"
			};
		}

		<div class="portfolio-quote text-center">
			<p class="@textColor">@Model.Quote</p>
		</div>

	</section>
</div>

<!--Photo Gallery-->
<div class="photo-gallery">
	@{
		foreach (Photo photo in Model.Photos)
		{
			<img class="gallery-photo"
				 src="@photo.ImagePath"
				 title="View Photo"
				 alt="Portfolio Photo" />
		}
	}
</div>

<!--Click To Enlarge Photo-->
<div id="lightbox" class="lightbox">
	<img id="lightbox-image"
		 alt="Enlarged portfolio photo" />
</div>

<script src="~/js/lightbox.js"></script>
